# ========================================================
# EREPS Data Management System - Environment Configuration
# ========================================================

# Project metadata
PROJECT_NAME="EREPS Member Data Management System"
VERSION="1.0.0"

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ereps_db
# Set DATABASE_URL if connecting to a dedicated PostgreSQL instance:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ereps_db
# Default local fallback (zero configuration required):
# DATABASE_URL=sqlite:///./ereps.db

# Security & JWT Tokens
SECRET_KEY=ereps-super-secret-production-encryption-key-2026-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Extraction & Rate Limits
DEFAULT_BATCH_SIZE=50
DEFAULT_RATE_LIMIT_PER_MIN=30
DATA_DIR=./data
EXPORT_DIR=./data/exports

# EREPS Live Integration Keys (Leave blank until official agreement is confirmed)
EREPS_PARTNER_API_KEY=
EREPS_AUTHORIZATION_TOKEN=
